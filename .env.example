# ─────────────────────────────────────────────
#  Copia este archivo a .env y cambia los valores
#  cp .env.example .env
# ─────────────────────────────────────────────

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena
MYSQL_USER=api_user
MYSQL_PASSWORD=cambia_esta_contrasena
MYSQL_DB=transporte_db

# RabbitMQ  (por defecto usa el usuario integrado de la imagen)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Correo SMTP para enviar facturas de reserva
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, usar "contrasena de aplicacion"
# Si se deja vacio, el sistema funciona pero no envia correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion
SMTP_FROM=tu_correo@gmail.com
SMTP_FROM_NAME=ReservaYa
